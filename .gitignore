# ==============================================================================
# Talaria Enterprise Zero-Leakage .gitignore
# Compliance Baseline: SOC 2 Type II, PCI-DSS v4.0, CIS Benchmarks
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Compiled Binaries, Build Outputs & Distributions
# ------------------------------------------------------------------------------
bin/
dist/
build/
talaria
Talaria
talaria-static
talaria.sh
*.exe
*.exe~
*.dll
*.so
*.dylib
*.gz
*.tar
*.tar.gz
*.zip

# ------------------------------------------------------------------------------
# 2. Test Outputs, Coverage Profiles & Execution Traces
# ------------------------------------------------------------------------------
*.test
*.out
*.pprof
*.coverprofile
coverage.*
profile.cov

# ------------------------------------------------------------------------------
# 3. Core Dumps, Logs & Crash Stack Traces
# ------------------------------------------------------------------------------
*.log
*.dump
core.[0-9]*
*.stackdump

# ------------------------------------------------------------------------------
# 4. Language & Environment Caches (Python, Node, Go)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
node_modules/
.cache/
go.work
go.work.sum
vendor/

# ------------------------------------------------------------------------------
# 5. IDE, Editor & Operating System Artifacts
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
.env
.env.*

# ------------------------------------------------------------------------------
# 6. Local Scratchpads, Staging Artifacts & Lab Suites
# ------------------------------------------------------------------------------
test_report.txt
scan_results
*.tmp
lab/
lab_reports/
Dockerfile.lab
docker-compose.lab.yml
LAB_GUIDE.md
SCANNERS_DETAILED_GUIDE.md
improvement_analysis.md
PROPOSED_SCANNERS_AND_IMPROVEMENTS.md
FUTURE_PLANS.md
STANDARDS_AND_REMEDIATION_MATRIX.md
internal/*.md
codebase_analysis.md
/ARCHITECTURE.md

# Local agent workspace directory and GitHub configuration
.agents/
.github/

# ------------------------------------------------------------------------------
# 7. Explicit Inclusion Whitelist for Enterprise Documentation
# ------------------------------------------------------------------------------
!docs/
!docs/**
