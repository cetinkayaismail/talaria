# ==============================================================================
# Talaria — Docker Laboratory Environment
# ==============================================================================
# Multi-stage Dockerfile that compiles Talaria and populates a controlled Linux
# testbed with safe mock misconfigurations to verify scanner findings visually.

FROM golang:1.22-bookworm AS builder
WORKDIR /app

# Copy Go module manifests & source
COPY go.mod ./
COPY . .

# Build static Talaria binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /app/bin/talaria main.go

# ------------------------------------------------------------------------------
# Target Testbed Stage
# ------------------------------------------------------------------------------
FROM debian:bookworm-slim

# Install base runtime tools & utilities for auditing
RUN apt-get update && apt-get install -y --no-install-recommends \
    sudo \
    cron \
    procps \
    libcap2-bin \
    net-tools \
    curl \
    ca-certificates \
    python3 \
    tmux \
    screen \
    logrotate \
    && rm -rf /var/lib/apt/lists/*

# Create unprivileged test user 'tester'
RUN useradd -m -s /bin/bash tester && \
    echo "tester:testerpass" | chpasswd

# Copy built Talaria binary
COPY --from=builder /app/bin/talaria /usr/local/bin/talaria

# Copy lab setup script
COPY lab/setup_mock_env.sh /usr/local/bin/setup_mock_env.sh
RUN chmod +x /usr/local/bin/setup_mock_env.sh && /usr/local/bin/setup_mock_env.sh

WORKDIR /home/tester
USER tester

CMD ["/usr/local/bin/talaria"]
